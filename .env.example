# Production is online-only. Export these variables in your shell; this file is
# documentation only and is never loaded automatically.
OPENAI_API_KEY=
GEMINI_API_KEY=

# auto tries providers in this order and fails over on request/API errors.
AI_PROVIDER_ORDER=openai,gemini
OPENAI_MODEL=gpt-5.4-mini
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MESSAGE_BATCH_SIZE=20
